#!/usr/bin/env node
const path = require("path");

const SCRIPTS = path.resolve(__dirname, "..", "scripts");
const cmd = process.argv[2];

// --help / -h / 无参数 → 打印帮助
if (!cmd || cmd === "--help" || cmd === "-h") {
  console.log(`stmem — Stone Memory 多线程记忆系统

用法:
  stmem status                                  查看所有线程状态
  stmem ai-help                                输出给外部 Agent 的安全操作协议
  stmem capabilities [--json]                  声明内置导入、挖掘与重建能力
  stmem doctor --memory <id> [--json]           只读诊断配置、Binding 与运行状态
  stmem delete --thread <id> [--dry-run]        删除线程配置及数据
  stmem init --new [--name <名称>]              新建未配置记忆体草稿
  stmem init --memory <id> --batch-file <json>  为记忆体绑定首个线程
  stmem init --template [--runtime codex] [--scenario life-supervision]       输出 AI 可填写的 JSON 模板
  stmem init --memory <id> --batch-file <json> --validate 严格校验配置和真实线程文件
  stmem fork --parent <id> --thread <id>        将线程登记为共享父级记忆的子线程
  stmem feature-phrases [--memory <id>]         从所有清洗后的 features 提取通用检索词
  stmem feature-evidence [--memory <id>]        回查 archive 与 feelings 的词频证据
  stmem compress [--memory <id>] [--before 日期]  dry-run 压缩 daily feelings
  stmem compact [--memory <id>] [--apply]       周级压缩预览或执行
  stmem hidden [--memory <id>] [--apply]        长期沉寂预览或执行
  stmem lifecycle [--memory <id>]               feeling 生命周期只读报告
  stmem term-timeline --memory <id> --terms <词列表>  archive 曲线与 feeling 小点
  stmem import --source <json|jsonl|sqlite>       预览导入映射（加 --apply 写入）
  stmem import --dir <path> [--memory <id>]       递归预览目录中的对话数据
  stmem tool-policy status|detect|filtered|preview|apply|unfilter-preview|unfilter|reset-cleaning|rollback-formatting --memory <id>  检测并配置全量对话清洗
  stmem binding list|add|discover-successors|import|batches|revert    多端绑定、fork 后继发现与可逆对话导入
  stmem module <模块ID> <action> [--batch-file <json>] 运行 manifest 登记的开发者模块命令
  stmem mine [--memory <id>] --all                  挖掘全部未处理日期，生成feelings + features
  stmem mine [--memory <id>] [--date <YYYY-MM-DD>]  挖掘单日 feelings + features
  stmem mine --memory <id> --date <日期> --check --json  自检提示词、输入、上游响应与返回格式
  stmem scenario list|inspect <id>             查看挖掘场景
  stmem scenario set --memory <id> --scenario <id> [--apply]  切换场景
  stmem prompt show|set --memory <id>           查看或覆盖当前场景提示词
  stmem mine-review preview|list|mix|apply|discard            可审阅候选与按日替换
  stmem scratch inspect|settings|generate --thread <id>      刮刮乐奖励读取、设置与生成
  stmem dream --thread <id> --date <YYYY-MM-DD>     织梦：为已挖掘完成的日期生成一场梦
  stmem dream preferences --thread <id>            查看织梦策略与秘典状态
  stmem dream pin --thread <id> --type <type>      梦向牵引：指定下一场梦类型
  stmem dream unpin --thread <id>                  取消梦向牵引
  stmem dream guard --thread <id> [--exclude <type>] 安梦守护：设置随机排除的梦境类型
  stmem dream multiplier --thread <id> --<type> <x> 梦谱调律：调整某类型倍率
  stmem dream nsfw --thread <id> on|off            开启或关闭成年亲密主题梦境
  stmem dream prompt --thread <id> --type <key> [--set <file>|--reset]  织梦秘典：查看/保存/恢复 Prompt
  stmem rebuild --thread <id> [--window N] [--tool-pairs N]  预览重建
  stmem rebuild --thread <id> --queue           安全排队，下次主 MCP 启动时应用
  stmem rebuild --thread <id> --summary-limit N --min-importance N  临时筛选本次注入摘要
  stmem rebuild --thread <id> --apply           实际写入
  stmem rebuild --thread <id> --check           检查活动线程结构完整性
  stmem rebuild --thread <id> --repair          备份并修复可恢复的线程断链
  stmem rules list|import|update|delete|enable|disable --memory <id>  管理人设/规则
  stmem memory update|anchor --memory <id> --batch-file <json>  编辑摘要与锚点
  stmem memory create [--name <名称>]            创建未绑定窗口的记忆体
  stmem memory settings --memory <id> --batch-file <json> --validate|--apply 读取或修改记忆体设置
  stmem memory migrate-layout --memory <旧版ID> [--batch-file <json>] [--apply] 升级旧版目录布局
  stmem memory delete --memory <id> [--apply]     预览或可恢复删除空草稿
  stmem api-profile set --batch-file <json> --validate|--apply  保存全局 API 凭据配置
  stmem watcher [status|on|off] --memory <id>   查看/修改该记忆体 watcher 期望状态
  stmem watcher service install|status|repair|remove  管理 Windows Task Scheduler watcher 服务
  stmem watcher set --memory <id> --archive|--miner|--compression|--dream on|off  修改内置插件
  stmem watcher set --memory <id> --dev-<name> on|off  修改开发者插件（必须 dev- 前缀）
  stmem notebook status|topic-create|topic-update|write|query|read|list --thread <id>
                                                管理主题 Markdown 笔记本
  stmem module list|inspect|paths|audit          查看模块、统一路径与执行模块契约审计
  stmem module mcp status|enable|disable        模块 MCP 状态与显式启停（默认 dry-run，--apply 写入）
  stmem web [--host 地址] [--port 4173]          前台启动本地记忆管理前端（兼容旧用法）
  stmem web start|stop|restart|status            管理后台前端进程；后台自动监听 Web 后端源码
  stmem web dev [--host 地址] [--port 4173]      前台开发模式；后端源码变化自动重启
  stmem web config --host <地址> --port <端口> [--url <访问地址>]  保存启动配置
  stmem web auth status|rotate|claim|devices|revoke|clear [--json]  管理 Web 令牌与登录设备
  stmem web lan enable|disable|status [--json]    开关有登录保护的局域网访问
  stmem supervisor start|stop|restart|status     管理唯一 watcher supervisor
  stmem db [status|migrate|migrate-all|export] [--memory <id>]  数据库管理

记忆体命令默认取第一个已配置 memoryId；兼容期仍接受同值的 --thread。

配置: ~/.stone_memory/stmem.json`);
  process.exit(0);
}

switch (cmd) {
  case "api-profile":
    require(path.join(SCRIPTS, "stmem-api-profile"));
    break;
  case "ai-help":
    require(path.join(SCRIPTS, "stmem-ai-help"));
    break;
  case "capabilities":
    require(path.join(SCRIPTS, "stmem-capabilities"));
    break;
  case "doctor":
    require(path.join(SCRIPTS, "stmem-doctor"));
    break;
  case "init":
    require(path.join(SCRIPTS, "stmem-init"));
    break;
  case "fork":
    require(path.join(SCRIPTS, "stmem-fork"));
    break;
  case "feature-phrases":
    require(path.join(SCRIPTS, "stmem-feature-phrases"));
    break;
  case "feature-evidence":
    require(path.join(SCRIPTS, "stmem-feature-evidence"));
    break;
  case "compress":
    require(path.join(SCRIPTS, "stmem-compress"));
    break;
  case "compact":
    require(path.join(SCRIPTS, "stmem-compact"));
    break;
  case "hidden":
    require(path.join(SCRIPTS, "stmem-hidden"));
    break;
  case "lifecycle":
    require(path.join(SCRIPTS, "stmem-lifecycle"));
    break;
  case "term-timeline":
    require(path.join(SCRIPTS, "stmem-term-timeline"));
    break;
  case "mine":
    require(path.join(SCRIPTS, "stmem-mine"));
    break;
  case "scenario":
    require(path.join(SCRIPTS, "stmem-scenario"));
    break;
  case "prompt":
    require(path.join(SCRIPTS, "stmem-prompt"));
    break;
  case "mine-review":
    require(path.join(SCRIPTS, "stmem-mine-review"));
    break;
  case "scratch":
    Promise.resolve(require(path.join(SCRIPTS, "stmem-scratch")).runScratchCommand(process.argv.slice(3)))
      .catch(error => {
        console.error(`[scratch] error: ${error.message}`);
        process.exitCode = 1;
      });
    break;
  case "dream":
    try {
      require(path.join(SCRIPTS, "stmem-dream")).runDreamCommand(process.argv.slice(3));
    } catch (error) {
      console.error(error.message);
      process.exit(1);
    }
    break;
  case "notebook":
    try {
      require(path.join(SCRIPTS, "stmem-notebook")).runNotebookCommand(process.argv.slice(3));
    } catch (error) {
      console.error(error.message);
      process.exit(1);
    }
    break;
  case "module":
    Promise.resolve(require(path.join(SCRIPTS, "stmem-module")).runModuleCommand(process.argv.slice(3))).catch(error => {
      console.error(`[module] error: ${error.message}`);
      process.exit(1);
    });
    break;
  case "rebuild":
    require(path.join(SCRIPTS, "stmem-rebuild"));
    break;
  case "rules":
    require(path.join(SCRIPTS, "stmem-rules"));
    break;
  case "memory":
    require(path.join(SCRIPTS, "stmem-memory"));
    break;
  case "status":
    require(path.join(SCRIPTS, "stmem-status"));
    break;
  case "list":
    require(path.join(SCRIPTS, "stmem-list"));
    break;
  case "delete":
    require(path.join(SCRIPTS, "stmem-delete"));
    break;
  case "sync":
    require(path.join(SCRIPTS, "stmem-sync"));
    break;
  case "import":
    require(path.join(SCRIPTS, "stmem-import"));
    break;
  case "tool-policy":
    try { console.log(JSON.stringify(require(path.join(SCRIPTS, "stmem-tool-policy")).runToolPolicy(process.argv.slice(3)), null, 2)); }
    catch (error) { console.error(error.message); process.exit(1); }
    break;
  case "binding":
    try {
      require(path.join(SCRIPTS, "stmem-binding")).runBindingCommand(process.argv.slice(3));
    } catch (error) {
      console.error(`[binding] ${error.message}`);
      process.exit(1);
    }
    break;
  case "adapt":
    require(path.join(SCRIPTS, "stmem-adapt"));
    break;
  case "watcher":
    require(path.join(SCRIPTS, "stmem-watcher"));
    break;
  case "web":
    require(path.join(SCRIPTS, "stmem-web"));
    break;
  case "supervisor":
    require(path.join(SCRIPTS, "stmem-supervisor"));
    break;
  case "db":
    require(path.join(SCRIPTS, "stmem-db"));
    break;
  default:
    console.log("未知命令: " + cmd + "\n运行 stmem --help 查看可用命令");
    process.exit(1);
}
