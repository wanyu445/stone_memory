{
  "name": "stone-memory",
  "version": "1.2.1",
  "description": "可解释的本地 AI 记忆与线程生命周期管理系统",
  "bin": {
    "stmem": "./bin/stmem"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.js",
    "start": "node bin/stmem web",
    "web": "node bin/stmem web",
    "dev": "node bin/stmem web dev",
    "test": "node --test",
    "test:supervisor": "node --test test/process-identity.test.js test/process-lock.test.js test/systemd-watcher-service.test.js test/watcher-runtime-state.test.js test/watcher-runtime.test.js test/watcher-supervisor-integration.test.js",
    "audit:developer-modules": "node bin/stmem module audit --strict"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wanyu445/stone_memory.git"
  },
  "keywords": ["ai-memory", "thread-lifecycle", "claude-code", "codex", "sqlite"],
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@node-rs/jieba": "^2.0.1",
    "better-sqlite3": "^13.0.3",
    "opencc-js": "^1.4.1"
  }
}
