{
  "$schema": "https://stone-memory.local/schemas/ui-theme-v3.json",
  "version": 3,
  "name": "月满中秋",
  "assets": {
    "logo": null
  },
  "tokens": {
    "colors": {
      "canvas": "#f5f1e8",
      "canvasWarm": "#fffaf0",
      "ink": "#3f4542",
      "inkSoft": "#69716c",
      "inkFaint": "#969b91",
      "accent": "#d6aa55",
      "accentStrong": "#b98732",
      "accentSoft": "#f6e9c7",
      "surface": "#fffdf7",
      "surfaceSoft": "#f4eedf",
      "line": "#dfd3b8",
      "lineSoft": "#eee6d5",
      "status": "#7f9b83",
      "danger": "#b9685f",
      "warning": "#c79246",
      "info": "#718b96",
      "conflict": "#ad716b",
